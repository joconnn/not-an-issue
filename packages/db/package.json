{
  "name": "@not-an-issue/db",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=../../.env --import tsx migrate.ts",
    "codegen": "kysely-codegen",
    "codegen:check": "kysely-codegen --verify"
  },
  "kysely-codegen": {
    "dialect": "postgres",
    "envFile": "../../.env",
    "outFile": "./types.ts",
    "includePattern": "public.+(workspace|workspace_member|project|issue|comment)"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "kysely": "^0.29.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
